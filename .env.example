# Configuracao para MoodTrack
# Copia este ficheiro para .env e preenche os valores

# === AUTENTICACAO GOOGLE ===
# 1. Vai a https://console.cloud.google.com/
# 2. Cria um projeto (ou usa um existente)
# 3. Vai a "APIs & Services" > "Credentials"
# 4. Cria "OAuth 2.0 Client ID" (tipo Web application)
# 5. Em "Authorized redirect URIs" adiciona: http://localhost:3000/api/google/callback
# 6. Copia o Client ID e Client Secret para aqui:
GOOGLE_CLIENT_ID=coloca_aqui_o_teu_google_client_id
GOOGLE_CLIENT_SECRET=coloca_aqui_o_teu_google_client_secret

# === BASE DE DADOS (Escolhe UMA opcao) ===

# Opcao A: SQLite local (RECOMENDADO para Windows - nao precisa de XAMPP!)
DATABASE_URL=./moodtrack.db

# Opcao B: MySQL local via XAMPP
# DATABASE_URL=mysql://root:@localhost:3306/moodtrack

# === URL DA APP ===
APP_URL=http://localhost:3000

# === SECRETO PARA JWT ===
APP_SECRET=moodtrack-secret-key-change-in-production

# === ADMIN ===
OWNER_UNION_ID=admin

# === SPOTIFY API (para buscar musicas) ===
SPOTIFY_CLIENT_ID=e237a37b3022467d9ecfa21727ee82f1
SPOTIFY_CLIENT_SECRET=e05c206dba14480a9862887b6285a2b5
